{
  "provider": "VoyageAI",
  "voyageai": {
    "apiKey": "${VOYAGEAI_API_KEY}",
    "model": "voyage-3-large",
    "dimensions": 1024,
    "endpoint": "https://api.voyageai.com/v1/embeddings",
    "batchSize": 128,
    "rateLimit": {
      "requestsPerMinute": 300,
      "maxRetries": 3,
      "retryDelay": 1000,
      "backoffMultiplier": 2
    }
  },
  "fallback": {
    "enabled": true,
    "provider": "local",
    "model": "all-MiniLM-L6-v2",
    "dimensions": 384
  },
  "cache": {
    "enabled": true,
    "directory": ".claude/helpers/.embedding-cache",
    "maxAge": 2592000000,
    "compressionEnabled": true
  }
}
