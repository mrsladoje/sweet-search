#!/usr/bin/env bash
# ss-trace: unified structural context for one symbol (callers, callees, impact).
#
# Usage: ss-trace <symbol> [--in <file>] [--query <hint>] [--depth N] [--budget N]
#        ss-trace <symbol> callers --in <defining file>   (mode word: callers, callees or impact)
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
. "$DIR/_ss-env.sh"
# The product command, exactly as an installed user runs it: the native client hands the
# call to the warm daemon, or runs it in-process when it cannot (core/agent-tools/).
exec "$DIR/../../../bin/ss-trace" "$@"
