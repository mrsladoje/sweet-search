#!/usr/bin/env bash
# ss-grep: indexed bare grep (gram-prefiltered) over the cwd's Sweet Search index.
# Compact agent-friendly output: file:line: full hit line (SS_FIX_GREP_FULLLINE=0: matched text)
#
# Usage:  ss-grep <regex> [-i|--ignore-case] [-k N]
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
. "$DIR/_ss-env.sh"
# The product command, exactly as an installed user runs it: the native client hands the
# call to the warm daemon, or runs it in-process when it cannot (core/agent-tools/).
exec "$DIR/../../../bin/ss-grep" "$@"
