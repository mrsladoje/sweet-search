#!/usr/bin/env bash
# Bench-local shim that lets spawned agents invoke `sweet-search` without
# requiring a global install. Forwards all args to core/cli.js.
#
# Resolved relative to this script's directory so it works regardless of cwd.
#
# THE PINS ARE NOT OPTIONAL HERE. This entry point does NOT route through
# _ss-helpers.mjs, so it used to reach node with none of the harness pins set —
# most importantly SWEET_SEARCH_INTRA_OP_THREADS. A run that mixed this shim with
# the ss-* wrappers therefore started some engines at a pinned thread count and
# some at the fleet-derived share, which is a tie-sensitive score difference
# inside the harness whose job is to measure score. `_ss-env.sh` is the one place
# those pins live; every executable in this directory sources it.
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
. "$DIR/_ss-env.sh"
REPO_ROOT="$( cd "$DIR/../../.." && pwd )"
exec node "$REPO_ROOT/core/cli.js" "$@"
