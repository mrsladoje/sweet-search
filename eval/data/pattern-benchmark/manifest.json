{
  "$schema": "pattern-benchmark-manifest-v1",
  "version": "1.0.0",
  "frozen": true,
  "frozenDate": "2026-03-23",
  "description": "ColGrep pattern benchmark contract — hybrid regex + semantic search evaluation",
  "references": ["docs/COLGREP_PLAN.md", "Phase 0a: Benchmark Contract Freeze"],

  "repos": [
    {
      "id": "sweet-search",
      "path": ".",
      "queryFile": "eval/data/pattern-benchmark/queries.jsonl",
      "description": "Sweet Search codebase (self-referential benchmark)",
      "languages": ["javascript"],
      "queries": 60,
      "size": "medium",
      "namingQuality": "descriptive",
      "notes": "Well-named functions and classes; grep should do well on many queries"
    },
    {
      "id": "ripgrep",
      "url": "https://github.com/BurntSushi/ripgrep.git",
      "sha": "4519153e5e461527f4bca45b042fff45c4ec6fb9",
      "path": "eval/repos/ripgrep",
      "queryFile": "eval/data/pattern-benchmark-ripgrep/queries.jsonl",
      "description": "ripgrep — fast regex search tool (Rust)",
      "languages": ["rust"],
      "queries": 119,
      "size": "medium",
      "namingQuality": "mixed",
      "notes": "Rust snake_case with abbreviated names; good test for non-JS languages"
    },
    {
      "id": "gin",
      "url": "https://github.com/gin-gonic/gin.git",
      "sha": "d3ffc9985281dcf4d3bef604cce4e662b1a327a6",
      "path": "eval/repos/gin",
      "queryFile": "eval/data/pattern-benchmark-gin/queries.jsonl",
      "description": "gin — HTTP web framework (Go)",
      "languages": ["go"],
      "queries": 120,
      "size": "small",
      "namingQuality": "abbreviated",
      "notes": "Go-style short names, unexported functions; hardest for grep"
    },
    {
      "id": "flask",
      "url": "https://github.com/pallets/flask.git",
      "sha": "7ef2946fb5151b745df30201b8c27790cac53875",
      "path": "eval/repos/flask",
      "queryFile": "eval/data/pattern-benchmark-flask/queries.jsonl",
      "description": "Flask — micro web framework (Python)",
      "languages": ["python"],
      "queries": 120,
      "size": "small",
      "namingQuality": "descriptive",
      "notes": "Clean Python with decorators, type hints, dunder methods"
    },
    {
      "id": "fastify",
      "url": "https://github.com/fastify/fastify.git",
      "sha": "39f0f24233cf6da2fef48551f51be2f589f7d5d0",
      "path": "eval/repos/fastify",
      "queryFile": "eval/data/pattern-benchmark-fastify/queries.jsonl",
      "description": "Fastify — fast Node.js web framework (JavaScript)",
      "languages": ["javascript"],
      "queries": 120,
      "size": "medium",
      "namingQuality": "mixed",
      "notes": "JS with prototype chains, Symbols, async patterns"
    }
  ],

  "totalQueries": 539,
  "totalRepos": 5,
  "totalLanguages": 4,
  "fetchScript": "eval/scripts/fetch-benchmark-repos.js",
  "multiRepoBench": "eval/scripts/multirepo-bench.js",

  "regexFamilies": {
    "class": {
      "description": "Class definition patterns",
      "examples": ["class.*Service", "class.*Index", "class.*Handler"],
      "difficulty": "easy-medium"
    },
    "function": {
      "description": "Function/method definition patterns",
      "examples": ["function.*search", "async function.*", "export.*function"],
      "difficulty": "easy-medium"
    },
    "import": {
      "description": "Import/require patterns",
      "examples": ["import.*from", "require\\("],
      "difficulty": "easy"
    },
    "export": {
      "description": "Export patterns revealing public API surface",
      "examples": ["export.*class", "export.*function", "export.*const.*CONFIG"],
      "difficulty": "easy"
    },
    "config": {
      "description": "Configuration constant patterns",
      "examples": ["const.*CONFIG", "const.*THRESHOLD", "const.*DEFAULT"],
      "difficulty": "medium"
    },
    "method": {
      "description": "Method patterns inside classes",
      "examples": ["async.*search\\(", "async.*score\\(", "\\)\\s*\\{"],
      "difficulty": "medium-hard"
    },
    "structural": {
      "description": "Structural code patterns (loops, conditionals, error handling)",
      "examples": ["try\\s*\\{", "catch\\s*\\(", "switch\\s*\\("],
      "difficulty": "hard"
    },
    "test": {
      "description": "Test framework patterns",
      "examples": ["describe\\(", "it\\(.*should", "expect\\("],
      "difficulty": "easy"
    }
  },

  "baselines": {
    "rg-only": {
      "description": "Pure ripgrep — no ranking, file:line output",
      "mode": null,
      "usesRegex": true,
      "usesSemantic": false,
      "notes": "Baseline for recall ceiling; no relevance ranking"
    },
    "hybrid-no-regex": {
      "description": "Sweet Search hybrid mode (BM25 + semantic) without regex",
      "mode": "hybrid",
      "usesRegex": false,
      "usesSemantic": true,
      "notes": "Shows whether semantic alone finds the right code"
    },
    "pattern-maxsim": {
      "description": "ColGrep pattern mode — regex candidates + MaxSim ranking",
      "mode": "pattern",
      "usesRegex": true,
      "usesSemantic": true,
      "notes": "Primary treatment — the feature under test"
    }
  },

  "evaluationSlices": {
    "byLanguage": {
      "description": "Per-language breakdown",
      "values": ["javascript"],
      "extendable": true
    },
    "byRegexFamily": {
      "description": "Per regex family (class, function, import, etc.)",
      "values": ["class", "function", "import", "export", "config", "method", "structural", "test"]
    },
    "byDifficulty": {
      "description": "Per difficulty level",
      "values": ["easy", "medium", "hard"]
    },
    "byNamingQuality": {
      "description": "Whether the target code uses descriptive names (grep advantage) or abbreviations",
      "values": ["descriptive", "abbreviated", "mixed"]
    }
  },

  "metrics": {
    "primary": {
      "mrr_at_10": { "description": "Mean Reciprocal Rank at 10", "target": 0.7, "regressionThreshold": -0.02 },
      "recall_at_5": { "description": "Recall at 5", "target": 0.6, "regressionThreshold": -0.03 },
      "recall_at_10": { "description": "Recall at 10", "target": 0.8, "regressionThreshold": -0.03 }
    },
    "secondary": {
      "latency_p50_ms": { "description": "Median latency", "aspirationalTarget": 100 },
      "latency_p95_ms": { "description": "95th percentile latency", "aspirationalTarget": 200 },
      "success_at_1": { "description": "Hit rate at rank 1" },
      "ndcg_at_10": { "description": "NDCG at 10" }
    },
    "pattern_specific": {
      "grep_match_rate": { "description": "Fraction of queries where regex finds at least one match" },
      "indexed_chunk_rate": { "description": "Fraction of grep matches that map to indexed chunks" },
      "win_rate_vs_rg": { "description": "Win rate of pattern mode vs rg-only baseline" },
      "win_rate_vs_hybrid": { "description": "Win rate of pattern mode vs hybrid-no-regex baseline" }
    }
  },

  "statisticalProtocol": {
    "bootstrapSamples": 1000,
    "confidenceLevel": 0.95,
    "significanceTest": "paired-bootstrap",
    "manualAuditSample": {
      "minSamples": 20,
      "focusOn": ["judge-disagreements", "rg-wins", "large-score-gaps"]
    }
  },

  "loggingSchema": {
    "perQuery": {
      "queryId": "string",
      "regex": "string",
      "semanticQuery": "string",
      "baseline": "string",
      "grepMatches": "number",
      "indexedChunks": "number",
      "maxSimCandidates": "number",
      "topResult": "string",
      "topScore": "number",
      "reciprocalRank": "number",
      "recall5": "number",
      "grepTime_ms": "number",
      "encodeTime_ms": "number",
      "rerankTime_ms": "number",
      "totalTime_ms": "number"
    }
  },

  "queryFormat": {
    "description": "Each query in queries.jsonl follows this schema",
    "fields": {
      "query_id": "Unique identifier (p001, p002, ...)",
      "regex": "Regex pattern for ripgrep candidate generation",
      "semantic_query": "Natural language query for MaxSim ranking",
      "relevant_files": "Array of file paths containing the expected results",
      "relevant_chunks": "Array of file:startLine-endLine chunk identifiers (gold labels)",
      "relevant_chunk_ids": "Array of gold chunk IDs in format file:startLine-endLine:index",
      "language": "Programming language of the target code",
      "regex_family": "One of: class, function, import, export, config, method, structural, test",
      "difficulty": "One of: easy, medium, hard",
      "naming_quality": "One of: descriptive, abbreviated, mixed",
      "notes": "Human-readable explanation of what this query tests",
      "split": "One of: dev, test — query split for avoiding overfitting"
    },
    "chunkMatchingStrategy": {
      "description": "How gold chunk IDs are matched against search result IDs during evaluation",
      "primaryMatch": "Exact string match: goldId === result.id",
      "fuzzyFallback": "When exact match fails, match by: (1) same file path AND (2) line range overlap > 50% relative to gold chunk length",
      "rationale": "Fuzzy fallback makes evaluation robust to chunk boundary shifts that occur during re-indexing without changing the gold labels",
      "goldIdFormat": "file:startLine-endLine:index  (e.g. core/sweet-search.js:88-116:3)",
      "overlapThreshold": 0.5
    }
  },

  "splitStrategy": {
    "description": "Queries are split into dev (tuning) and test (reporting) sets to prevent overfitting",
    "method": "Stratified by regex_family — last ~1/3 of each family assigned to test",
    "deterministic": true,
    "splits": {
      "dev": { "count": 40, "fraction": 0.67, "use": "Parameter tuning, sweeps, ablations" },
      "test": { "count": 20, "fraction": 0.33, "use": "Final reporting only — do not tune on these" }
    },
    "perFamily": {
      "class":      { "total": 8,  "dev": 5,  "test": 3, "testIds": ["p035","p036","p037"] },
      "function":   { "total": 18, "dev": 12, "test": 6, "testIds": ["p040","p043","p044","p045","p046","p047"] },
      "import":     { "total": 4,  "dev": 3,  "test": 1, "testIds": ["p014"] },
      "config":     { "total": 11, "dev": 7,  "test": 4, "testIds": ["p050","p051","p052","p053"] },
      "method":     { "total": 7,  "dev": 5,  "test": 2, "testIds": ["p056","p057"] },
      "structural": { "total": 8,  "dev": 5,  "test": 3, "testIds": ["p058","p059","p060"] },
      "test":       { "total": 4,  "dev": 3,  "test": 1, "testIds": ["p034"] }
    },
    "cliUsage": {
      "run_pattern_benchmark": "--split=all|dev|test (default: all)",
      "warm-bench": "--split=dev|test|all (default: all)",
      "sweep-grep-density": "--split=dev|test|all (default: dev)"
    }
  },

  "exitCriteria": {
    "phase0a": "Manifest frozen, baseline matrix defined, logging schema locked",
    "phase1": "Harness can run Track A, B1, and C automatically",
    "phase2_5": "Gold labels frozen, failure taxonomy locked, agent-eval rubric locked",
    "shipGate": "All tracks pass, manual audit clean, no systemic judge bias"
  }
}
